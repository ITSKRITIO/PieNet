# ---- Database (MySQL 8+) ----
# URL-encode special characters in the password (e.g. @ -> %40, $ -> %24).
DATABASE_URL="postgresql://neondb_owner:npg_ri19xHmjGuVe@ep-dawn-dawn-b33fzg1t-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ---- Sessions ----
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""
SESSION_DAYS=7

# ---- Admin code ----
# Base64 of a bcrypt hash of your admin code. Never put the plain code here.
# Generate with:  npm run admin:hash
ADMIN_CODE_HASH_B64=""

# ---- Signup protection (recommended) ----
# When set, new accounts must enter this code. Leave empty to allow open signup.
INVITE_CODE=""

# ---- Photo storage ----
STORAGE_DIR="./storage"
MAX_UPLOAD_MB=10

# ---- Server ----
PORT=3000
HOST=0.0.0.0
# Set to true only when running behind a reverse proxy you control (nginx, Caddy, ...).
TRUST_PROXY=false
# Defaults to true in production. Set to false if you serve production over plain http.
COOKIE_SECURE=
